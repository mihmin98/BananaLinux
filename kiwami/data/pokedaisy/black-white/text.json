            {
              "entries": [
                {
                  "answer": "Dark grass, grass that shakes and water that ripples each hold POKéMON of their own, often stronger or rarer than the plain grass around them.",
                  "hint": "They're not the plain grass.",
                  "randomized": "Randomized.ANY",
                  "title": "What about the dark grass and the grass that shakes?"
                }
              ],
              "heading": "WILD POKéMON",
              "randomized": {
                "answer": "Some places change their POKéMON with the seasons, and the seasons follow the month: January, May and September are spring, February, June and October summer, March, July and November autumn, April, August and December winter. HERE shows this month's list, by your DS clock (your device's).",
                "hint": "Look at the calendar.",
                "randomized": "Randomized.ANY",
                "title": "Why did the POKéMON here change?"
              }
            },
            {
              "heading": "GYMS",
              "randomized": {
                "answer": "The one whose type beats your first POKéMON's: CHILI (fire) if you picked SNIVY, CRESS (water) if you picked TEPIG, CILAN (grass) if you picked OSHAWOTT. NEXT BOSS shows all three teams.",
                "hint": "It depends on your first POKéMON.",
                "randomized": "Randomized.ANY",
                "title": "Which STRIATON CITY leader will I battle?"
