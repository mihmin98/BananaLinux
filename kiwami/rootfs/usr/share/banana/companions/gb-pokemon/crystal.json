  "notes": [
    {
      "id": "note-tip-1",
      "kind": "tip",
      "quality": "reference-only",
      "source": "PokeDaisy GuideCrystal.kt (CRYSTAL_TIPS)",
      "text": "The game's clock has three times of day: morning from 4 AM, day from 10 AM and night from 6 PM. Grass and caves have a list for each, and HERE shows the one for the time your game's clock says.",
      "title": "Why did the POKéMON on this route change?"
    },
    {
      "id": "note-tip-2",
      "kind": "tip",
      "quality": "reference-only",
      "source": "PokeDaisy GuideCrystal.kt (CRYSTAL_TIPS)",
      "text": "Each tree you HEADBUTT is common, rare or almost empty, picked from where the tree stands and your trainer ID. HERE lists both tables; try every tree on a route to find the rare ones.",
      "title": "Why do some trees never have the rare POKéMON?"
    }
