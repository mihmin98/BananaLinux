From: mihmin98 <51593459+mihmin98@users.noreply.github.com>
Subject: [PATCH] gfx/drm: kiwami clocks, a frame-driven clock governor

The kiwami fork's CPU and GPU clock governor for the KMS context (its
setting Power scaling): the lowest CPU clock at which the core's frames fit,
under the "performance" governor with a stepped scaling_max_freq, and the
GPU's devfreq floor raised when a frame on time still missed its flip, held
longer each time it turns out still needed; a CPU step down that leaves the
GPU's pass no room is undone instead. It works on the core's period (the
display's when RetroArch runs the core at the display's rate) and the main
thread's CPU time per core frame, follows fast-forward's limit, remembers
each game's clocks (the highest CPU clock it needed, the GPU floor held
longest), and logs at exit each step and late flip with the numbers behind
it.

Its files only, plain C89 with no RetroArch headers: the caller gives it
every time, fact and path, so it is built and tested on its own. Nothing
calls it yet; the next patch builds it into the KMS context.

Upstream-Status: Inappropriate [kiwami fork-specific]
---
--- /dev/null
+++ b/gfx/drivers_context/kiwami_clocks.h
@@ -0,0 +1,35 @@
+/* A frame-driven CPU and GPU clock governor for the KMS context, the kiwami
+ * fork's. Plain C with no RetroArch headers: the caller gives it every
+ * fact, time and path. */
+
+#ifndef KIWAMI_CLOCKS_H__
+#define KIWAMI_CLOCKS_H__
+
+#include <stdint.h>
+
+struct kiwami_clocks_frame
+{
+   int64_t now_us;      /* CLOCK_MONOTONIC, at the swap */
+   int64_t cpu_us;      /* the main thread's CPU time, at the swap */
+   int64_t frame_no;    /* the core's frames so far, 0 unknown */
+   double  fps;         /* the core's */
+   double  refresh_hz;  /* the display mode's */
+   double  skew;        /* audio_max_timing_skew with vsync on, else 0 */
+   int64_t pace_us;     /* RetroArch's smoothed iteration period, 0 unknown */
+   int64_t ff_limit_us; /* fast-forward's frame limit, 0 none */
+   int     ff;          /* fast-forward on */
+   int     hold;        /* menu, pause, slow motion: nothing counted */
+};
+
+/* cpu_dir: a cpufreq policy; gpu_dir: a devfreq device, or NULL. 0: off. */
+int      kiwami_clocks_start(const char *cpu_dir, const char *gpu_dir,
+      const char *data_dir, const char *log_path,
+      const char *core, const char *game);
+void     kiwami_clocks_swap(const struct kiwami_clocks_frame *f);
+/* A page flip's time, CLOCK_MONOTONIC. */
+void     kiwami_clocks_flip(int64_t t_us);
+void     kiwami_clocks_stop(void);
+/* The CPU clock it set, 0 off. */
+unsigned kiwami_clocks_mhz(void);
+
+#endif
--- /dev/null
+++ b/gfx/drivers_context/kiwami_clocks.c
@@ -0,0 +1,846 @@
+/* The kiwami fork's clock governor, BananaFront's --cpugov and gpufloor for
+ * RetroArch's KMS context.
+ *
+ * CPU: the "performance" governor with a stepped scaling_max_freq, the
+ * lowest clock at which the core's frames fit. Work is the main thread's CPU
+ * time between swaps, so a wait (vsync, audio, the frame limiter) never
+ * counts, judged against the core's period: the display's (or a whole
+ * multiple of it) when RetroArch runs the core at the display's rate, as it
+ * does within audio_max_timing_skew, else the core's own.
+ * - Up a step when a second's slowest work (p99) passes 90% of the period.
+ * - Up at once on a late frame (a late flip, or the game running slow for a
+ *   second, with the work over 80%), two steps for two in a second; that
+ *   clock is banned for 30 s, doubled each time it fails again.
+ * - Down a step after 5 s with no change and no late frame, when the p99
+ *   scaled to the lower clock fits 65% of the period. A late frame within
+ *   5 s of it with the work under 80% is that step's (the GPU's pass shares
+ *   the period with the work): back up at once, that clock banned as above.
+ * GPU: devfreq's min_freq up a step on a late flip, or the game running
+ * slow, with the work under 80% and no step down just before; down a step
+ * after 30 s without one, a hold doubled each time a floor is needed again
+ * within 10 s of its drop.
+ * The game's clocks: the CPU's highest it was stepped up to (or, with none,
+ * the one it ended on, never over the one it started a step above), the
+ * GPU's floor held longest.
+ * Fast-forward: the top clock with no limit, else a step a second until the
+ * limit is reached; the clock from before comes back after it, and nothing
+ * of it is learnt.
+ * Under threaded video a screen update may bring no core frame or two: the
+ * work is per core frame, an update's divided by the frames it brought, one
+ * with none carried to the next.
+ * The menu, pause and any gap over 100 ms count nothing. sysfs is written
+ * only on a step (and the GPU's clock read on a late flip); the log, with
+ * the numbers behind each step and late flip, and the game's clocks only at
+ * stop. */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+#include "kiwami_clocks.h"
+
+#define KC_MAXF        16
+#define KC_WIN         64
+#define KC_EVENTS      512
+#define KC_SECOND      1000000
+#define KC_STALL_US    100000
+#define KC_LATE_GAP_US 300000
+#define KC_DOWN_US     5000000
+#define KC_BAN_US      30000000
+#define KC_GPU_GAP_US  250000
+#define KC_GPU_HOLD_US 30000000
+#define KC_GPU_SOON_US 10000000
+
+/* a step of the CPU's clock or the GPU's floor, or a late flip */
+struct kc_event
+{
+   int64_t t_us;
+   const char *why;
+   long gap_us;       /* a late flip's spacing */
+   unsigned from, to; /* a step's, MHz */
+   unsigned cpu, floor, gpu_at; /* a late flip's clocks, MHz, 0 none */
+   int kind;          /* KC_CPU, KC_GPU, KC_LATE */
+   int pct;           /* the p99 or work, % of the period, -1 none */
+};
+
+#define KC_CPU  0
+#define KC_GPU  1
+#define KC_LATE 2
+
+static struct
+{
+   int on, stopped, have_last, have_flip, held, in_ff, synced;
+   int nf, cur, gnf, gcur, start_cur, start_gcur, mem_cpu, mem_gpu;
+   int nwin, nslow, nframes, late_1s, ff_from;
+   int need, mem_cur, down_to, why_pct;
+   unsigned long f[KC_MAXF];  /* kHz */
+   unsigned long g[KC_MAXF];  /* Hz */
+   unsigned long old_min, old_max;
+   long win[KC_WIN];
+   long last_work, period_us, late_after_us;
+   long n_late_cpu, n_slow_cpu, n_late_gpu, n_slow_gpu, n_near, n_down;
+   long n_undone, carry;
+   long n_upd[3];             /* screen updates bringing 0, 1, 2+ frames */
+   long p99_at[KC_MAXF][11];  /* seconds by their p99, in tens of % */
+   long nsteps, nevents;
+   double fps, refresh_hz;
+   int64_t t0, last_now, last_cpu, last_flip, win_start, late_since;
+   int64_t last_change, last_late, g_last_change, g_last_miss;
+   int64_t g_hold, g_drop, down_at, undo_at;
+   int64_t ff_next, ff_us, last_frame_no;
+   int64_t ban_until[KC_MAXF], ban_len[KC_MAXF];
+   int64_t time_at[KC_MAXF], gtime_at[KC_MAXF];
+   char old_gov[32];
+   char cpu_dir[256], gpu_dir[256], log_path[512];
+   char core[128], game[256], data_dir[512], core_dir[640], store[1024];
+   struct kc_event ev[KC_EVENTS];
+} kc;
+
+static int kc_read(const char *dir, const char *name, char *out, size_t len)
+{
+   char path[320];
+   FILE *fp;
+   int ok;
+
+   snprintf(path, sizeof(path), "%s/%s", dir, name);
+   if (!(fp = fopen(path, "r")))
+      return 0;
+   ok = fgets(out, (int)len, fp) != NULL;
+   fclose(fp);
+   if (ok)
+      out[strcspn(out, "\n")] = '\0';
+   return ok;
+}
+
+static int kc_write(const char *dir, const char *name, const char *val)
+{
+   char path[320];
+   FILE *fp;
+   int ok;
+
+   snprintf(path, sizeof(path), "%s/%s", dir, name);
+   if (!(fp = fopen(path, "w")))
+      return 0;
+   ok = fputs(val, fp) >= 0;
+   return fclose(fp) == 0 && ok;
+}
+
+static int kc_write_ul(const char *dir, const char *name, unsigned long v)
+{
+   char b[32];
+   snprintf(b, sizeof(b), "%lu", v);
+   return kc_write(dir, name, b);
+}
+
+/* a number alone, spaces around it allowed */
+static int kc_num(const char *s, unsigned long *v)
+{
+   char *end;
+   while (*s == ' ' || *s == '\t')
+      s++;
+   if (*s < '0' || *s > '9')
+      return 0;
+   *v = strtoul(s, &end, 10);
+   while (*end == ' ' || *end == '\t' || *end == '\n' || *end == '\r')
+      end++;
+   return *end == '\0';
+}
+
+/* a frequency table, ascending, without repeats */
+static int kc_table(const char *s, unsigned long *t)
+{
+   int n = 0;
+
+   while (n < KC_MAXF)
+   {
+      char *end;
+      int i;
+      unsigned long v = strtoul(s, &end, 10);
+      if (end == s)
+         break;
+      s = end;
+      for (i = 0; i < n && t[i] != v; i++);
+      if (!v || i < n)
+         continue;
+      for (i = n; i > 0 && t[i - 1] > v; i--)
+         t[i] = t[i - 1];
+      t[i] = v;
+      n++;
+   }
+   return n;
+}
+
+static int kc_find(const unsigned long *t, int n, unsigned long v)
+{
+   int i;
+   for (i = 0; i < n; i++)
+      if (t[i] == v)
+         return i;
+   return -1;
+}
+
+/* a name as one path component */
+static void kc_name(char *out, size_t len, const char *in)
+{
+   size_t i;
+   for (i = 0; in && in[i] && i + 1 < len; i++)
+   {
+      unsigned char c = (unsigned char)in[i];
+      out[i] = (c == '/' || c < 0x20 || c == 0x7f) ? '_' : (char)c;
+   }
+   out[i] = '\0';
+   if (!out[0] || !strcmp(out, ".") || !strcmp(out, ".."))
+      snprintf(out, len, "_");
+}
+
+static void kc_log_line(const char *line)
+{
+   FILE *fp;
+   if (!kc.log_path[0] || !(fp = fopen(kc.log_path, "a")))
+      return;
+   fprintf(fp, "%s\n", line);
+   fclose(fp);
+}
+
+static struct kc_event *kc_event(int64_t now, int kind)
+{
+   struct kc_event *e = &kc.ev[kc.nevents++ % KC_EVENTS];
+   memset(e, 0, sizeof(*e));
+   e->t_us = now - kc.t0;
+   e->kind = kind;
+   e->pct  = -1;
+   return e;
+}
+
+/* a step, with the p99 of the second that took it (kc_eval's) */
+static void kc_step(int64_t now, int gpu, unsigned from, unsigned to,
+      const char *why)
+{
+   struct kc_event *e = kc_event(now, gpu ? KC_GPU : KC_CPU);
+   e->from = from;
+   e->to   = to;
+   e->why  = why;
+   e->pct  = kc.why_pct;
+   kc.nsteps++;
+}
+
+static int kc_pct(long us)
+{
+   return (int)((us * 100 + kc.period_us / 2) / kc.period_us);
+}
+
+static void kc_reset(int64_t now)
+{
+   kc.nwin      = 0;
+   kc.nslow     = 0;
+   kc.nframes   = 0;
+   kc.win_start = now;
+}
+
+static void kc_cpu(int i, int64_t now, const char *why)
+{
+   if (i < 0)
+      i = 0;
+   if (i >= kc.nf)
+      i = kc.nf - 1;
+   if (i == kc.cur)
+      return;
+   /* a clock the game needed, which its memory keeps (not fast-forward's) */
+   if (i > kc.cur && !kc.in_ff && i > kc.need)
+      kc.need = i;
+   kc_write_ul(kc.cpu_dir, "scaling_max_freq", kc.f[i]);
+   kc_step(now, 0, (unsigned)(kc.f[kc.cur] / 1000),
+         (unsigned)(kc.f[i] / 1000), why);
+   kc.cur         = i;
+   kc.last_change = now;
+   kc_reset(now);
+}
+
+static void kc_gpu(int i, int64_t now, const char *why)
+{
+   kc_write_ul(kc.gpu_dir, "min_freq", kc.g[i]);
+   kc_step(now, 1, (unsigned)(kc.g[kc.gcur] / 1000000),
+         (unsigned)(kc.g[i] / 1000000), why);
+   kc.gcur          = i;
+   kc.g_last_change = now;
+}
+
+/* the CPU's late frame: up now, that clock banned for a while */
+static void kc_cpu_late(int64_t now, const char *why)
+{
+   int bad = kc.cur;
+   if (now - kc.last_change < KC_LATE_GAP_US)
+      return;
+   if (now - kc.late_since >= KC_SECOND)
+   {
+      kc.late_1s    = 0;
+      kc.late_since = now;
+   }
+   kc.late_1s++;
+   kc.ban_until[bad] = now + kc.ban_len[bad];
+   kc.ban_len[bad]  *= 2;
+   kc.last_late      = now;
+   kc_cpu(kc.cur + (kc.late_1s >= 2 ? 2 : 1), now, why);
+}
+
+static void kc_gpu_late(int64_t now, const char *why)
+{
+   kc.g_last_miss = now;
+   if (     kc.gcur + 1 < kc.gnf
+         && now - kc.g_last_change >= KC_GPU_GAP_US)
+   {
+      /* the floor dropped was still needed: hold the next one longer */
+      if (kc.g_drop && now - kc.g_drop < KC_GPU_SOON_US)
+         kc.g_hold *= 2;
+      kc.g_drop = 0;
+      kc_gpu(kc.gcur + 1, now, why);
+   }
+}
+
+/* a late frame with its work on time. Within 5 s of a step down, that
+ * step's: the GPU's pass shares the period with the work, which the lower
+ * clock lengthened. Back up at once, that clock banned as a late frame's is,
+ * and the frames already under way at it count for nothing. Else the GPU's. */
+static void kc_late_short(int64_t now, const char *why, long *n_gpu)
+{
+   if (     kc.down_at
+         && kc.last_change == kc.down_at
+         && kc.cur == kc.down_to
+         && now - kc.down_at < KC_DOWN_US)
+   {
+      kc.n_undone++;
+      kc.ban_until[kc.cur] = now + kc.ban_len[kc.cur];
+      kc.ban_len[kc.cur]  *= 2;
+      kc.last_late         = now;
+      kc_cpu(kc.cur + 1, now, "late after a step down");
+      kc.undo_at           = now;
+      return;
+   }
+   if (     kc.undo_at
+         && kc.last_change == kc.undo_at
+         && now - kc.undo_at < KC_LATE_GAP_US)
+      return;
+   (*n_gpu)++;
+   kc_gpu_late(now, why);
+}
+
+static void kc_gpu_tick(int64_t now)
+{
+   if (     kc.gcur > 0
+         && now - kc.g_last_miss   >= kc.g_hold
+         && now - kc.g_last_change >= kc.g_hold)
+   {
+      kc_gpu(kc.gcur - 1, now, "quiet");
+      kc.g_drop = now;
+   }
+}
+
+static int kc_cmp(const void *a, const void *b)
+{
+   long x = *(const long*)a;
+   long y = *(const long*)b;
+   return x < y ? -1 : x > y;
+}
+
+static void kc_judge(int64_t now, long p99, int slow)
+{
+   int dn;
+
+   if (slow)
+   {
+      if (p99 * 5 > kc.period_us * 4)
+      {
+         kc.n_slow_cpu++;
+         kc_cpu_late(now, "running slow");
+      }
+      else
+         kc_late_short(now, "running slow", &kc.n_slow_gpu);
+      return;
+   }
+   if (p99 * 10 > kc.period_us * 9)
+   {
+      if (kc.cur < kc.nf - 1)
+      {
+         kc.n_near++;
+         kc_cpu(kc.cur + 1, now, "near the limit");
+      }
+      return;
+   }
+   if (     kc.cur <= 0
+         || now - kc.last_change < KC_DOWN_US
+         || now - kc.last_late   < KC_DOWN_US)
+      return;
+   dn = kc.cur - 1;
+   if (now < kc.ban_until[dn])
+      return;
+   if ((double)p99 * kc.f[kc.cur] / kc.f[dn] < kc.period_us * 0.65)
+   {
+      kc.n_down++;
+      kc_cpu(dn, now, "headroom");
+      kc.down_at = now;
+      kc.down_to = dn;
+   }
+}
+
+/* a second of frames at normal speed */
+static void kc_eval(int64_t now)
+{
+   long p99;
+   int slow, pct;
+
+   if (kc.nwin < 20)
+   {
+      kc_reset(now);
+      return;
+   }
+   qsort(kc.win, kc.nwin, sizeof(*kc.win), kc_cmp);
+   p99  = kc.win[(kc.nwin * 99) / 100];
+   slow = kc.nslow == kc.nframes;
+   kc_reset(now);
+   pct  = kc_pct(p99);
+   kc.p99_at[kc.cur][pct < 100 ? pct / 10 : 10]++;
+   kc.why_pct = pct;
+   kc_judge(now, p99, slow);
+   kc.why_pct = -1;
+}
+
+static void kc_ff(const struct kiwami_clocks_frame *f, int64_t now,
+      int64_t gap)
+{
+   if (!kc.in_ff)
+   {
+      kc.in_ff   = 1;
+      kc.ff_from = kc.cur;
+      kc.ff_next = now + KC_SECOND;
+      kc_reset(now);
+   }
+   kc.ff_us += gap;
+   if (f->ff_limit_us <= 0)
+   {
+      kc_cpu(kc.nf - 1, now, "fast-forward");
+      return;
+   }
+   if (now >= kc.ff_next)
+   {
+      kc.ff_next = now + KC_SECOND;
+      if (f->pace_us * 100 > f->ff_limit_us * 103)
+         kc_cpu(kc.cur + 1, now, "fast-forward");
+   }
+}
+
+int kiwami_clocks_start(const char *cpu_dir, const char *gpu_dir,
+      const char *data_dir, const char *log_path,
+      const char *core, const char *game)
+{
+   char b[512];
+   unsigned long v;
+   int i;
+   FILE *fp;
+
+   memset(&kc, 0, sizeof(kc));
+   snprintf(kc.cpu_dir,  sizeof(kc.cpu_dir),  "%s", cpu_dir ? cpu_dir : "");
+   snprintf(kc.gpu_dir,  sizeof(kc.gpu_dir),  "%s", gpu_dir ? gpu_dir : "");
+   snprintf(kc.log_path, sizeof(kc.log_path), "%s", log_path ? log_path : "");
+   kc_name(kc.core, sizeof(kc.core), core);
+   kc_name(kc.game, sizeof(kc.game), game);
+
+   if (     !kc.cpu_dir[0]
+         || !kc_read(kc.cpu_dir, "scaling_available_frequencies", b, sizeof(b))
+         || (kc.nf = kc_table(b, kc.f)) < 2
+         || !kc_read(kc.cpu_dir, "scaling_governor", kc.old_gov, sizeof(kc.old_gov))
+         || !kc_read(kc.cpu_dir, "scaling_min_freq", b, sizeof(b))
+         || !kc_num(b, &kc.old_min)
+         || !kc_read(kc.cpu_dir, "scaling_max_freq", b, sizeof(b))
+         || !kc_num(b, &kc.old_max))
+   {
+      kc_log_line("kiwami-clocks: off, no cpufreq");
+      return 0;
+   }
+
+   if (     kc.gpu_dir[0]
+         && kc_read(kc.gpu_dir, "available_frequencies", b, sizeof(b))
+         && (kc.gnf = kc_table(b, kc.g)) >= 2
+         && kc_read(kc.gpu_dir, "min_freq", b, sizeof(b)))
+   {
+      if (kc_read(kc.gpu_dir, "max_freq", b, sizeof(b)) && kc_num(b, &v))
+         while (kc.gnf > 1 && kc.g[kc.gnf - 1] > v)
+            kc.gnf--;
+   }
+   else
+      kc.gnf = 0;
+
+   /* the game's clocks from last time: the CPU a step above, the GPU's floor */
+   kc.cur     = kc.nf - 1;
+   kc.mem_cur = -1;
+   kc.need    = -1;
+   if (data_dir && *data_dir)
+   {
+      snprintf(kc.data_dir, sizeof(kc.data_dir), "%s", data_dir);
+      snprintf(kc.core_dir, sizeof(kc.core_dir), "%s/%s", kc.data_dir, kc.core);
+      snprintf(kc.store, sizeof(kc.store), "%s/%s.clocks", kc.core_dir, kc.game);
+      if ((fp = fopen(kc.store, "r")))
+      {
+         while (fgets(b, sizeof(b), fp))
+         {
+            if (!strncmp(b, "cpu ", 4) && kc_num(b + 4, &v)
+                  && (i = kc_find(kc.f, kc.nf, v)) >= 0)
+            {
+               kc.cur     = i + 1 < kc.nf ? i + 1 : i;
+               kc.mem_cur = i;
+               kc.mem_cpu = 1;
+            }
+            else if (!strncmp(b, "gpu ", 4) && kc_num(b + 4, &v)
+                  && (i = kc_find(kc.g, kc.gnf, v)) >= 0)
+            {
+               kc.gcur    = i;
+               kc.mem_gpu = 1;
+            }
+         }
+         fclose(fp);
+      }
+   }
+
+   if (!kc_write_ul(kc.cpu_dir, "scaling_min_freq", kc.f[0]))
+   {
+      kc_log_line("kiwami-clocks: off, no cpufreq");
+      return 0;
+   }
+   kc_write(kc.cpu_dir, "scaling_governor", "performance");
+   kc_write_ul(kc.cpu_dir, "scaling_max_freq", kc.f[kc.cur]);
+   if (kc.gnf)
+      kc_write_ul(kc.gpu_dir, "min_freq", kc.g[kc.gcur]);
+   for (i = 0; i < KC_MAXF; i++)
+      kc.ban_len[i] = KC_BAN_US;
+   kc.g_hold     = KC_GPU_HOLD_US;
+   kc.why_pct    = -1;
+   kc.start_cur  = kc.cur;
+   kc.start_gcur = kc.gcur;
+   kc.on         = 1;
+   return 1;
+}
+
+void kiwami_clocks_swap(const struct kiwami_clocks_frame *f)
+{
+   double refresh_us, fps, n, skew;
+   long whole;
+   int64_t now, gap, frames;
+   long work;
+
+   if (!kc.on || kc.stopped)
+      return;
+   now        = f->now_us;
+   refresh_us = 1000000.0 / (f->refresh_hz > 1.0 ? f->refresh_hz : 60.0);
+   fps        = f->fps > 1.0 ? f->fps : 1000000.0 / refresh_us;
+   /* RetroArch's own test (audio rate control): a core within the skew
+    * of the display's rate, or of a whole fraction of it, runs at it */
+   whole = (long)(1000000.0 / refresh_us / fps + 0.5);
+   if (whole < 1)
+      whole = 1;
+   skew  = 1.0 - fps * whole * refresh_us / 1000000.0;
+   if (skew < 0)
+      skew = -skew;
+   kc.synced = skew <= f->skew;
+   if (kc.synced)
+      kc.period_us = (long)(whole * refresh_us);
+   else
+   {
+      /* its own rate: a flip is late past the refreshes its spacing takes */
+      kc.period_us = (long)(1000000.0 / fps);
+      n     = kc.period_us / refresh_us - 0.001;
+      whole = (long)n;
+      if (whole < n)
+         whole++;
+      if (whole < 1)
+         whole = 1;
+   }
+   kc.late_after_us = (long)((whole + 0.5) * refresh_us);
+
+   if (!kc.have_last)
+   {
+      kc.have_last     = 1;
+      kc.t0            = now;
+      kc.fps           = f->fps;
+      kc.refresh_hz    = f->refresh_hz;
+      kc.last_now      = now;
+      kc.last_cpu      = f->cpu_us;
+      kc.last_frame_no = f->frame_no;
+      kc.last_change   = now;
+      kc.last_late     = now;
+      kc.late_since    = now;
+      kc.g_last_change = now;
+      kc.g_last_miss   = now;
+      kc.held          = f->hold;
+      kc_reset(now);
+      return;
+   }
+   gap         = now - kc.last_now;
+   work        = (long)(f->cpu_us - kc.last_cpu);
+   kc.last_now = now;
+   kc.last_cpu = f->cpu_us;
+   kc.held     = f->hold;
+   /* the core's frames this update brought: one when unknown */
+   frames      = 1;
+   if (f->frame_no > 0 && kc.last_frame_no > 0
+         && f->frame_no >= kc.last_frame_no)
+      frames   = f->frame_no - kc.last_frame_no;
+   kc.last_frame_no = f->frame_no;
+   if (f->hold || gap > KC_STALL_US || gap < 0)
+   {
+      kc.have_flip = 0;
+      kc.carry     = 0;
+      kc_reset(now);
+      return;
+   }
+
+   kc_gpu_tick(now);
+   if (f->ff)
+   {
+      kc.carry = 0;
+      kc_ff(f, now, gap);
+      return;
+   }
+   if (kc.in_ff)
+   {
+      kc.in_ff = 0;
+      kc_cpu(kc.ff_from, now, "fast-forward over");
+      kc_reset(now);
+      return;
+   }
+
+   kc.time_at[kc.cur]   += gap;
+   if (kc.gnf)
+      kc.gtime_at[kc.gcur] += gap;
+   if (frames < 1)
+   {
+      /* no frame yet: its work goes with the next */
+      kc.carry += work;
+      kc.n_upd[0]++;
+   }
+   else
+   {
+      work         = (long)((work + kc.carry) / frames);
+      kc.carry     = 0;
+      kc.n_upd[frames > 1 ? 2 : 1]++;
+      kc.last_work = work;
+      if (kc.nwin < KC_WIN)
+         kc.win[kc.nwin++] = work;
+   }
+   kc.nframes++;
+   if (f->pace_us > 0 && f->pace_us * 100 > (int64_t)kc.period_us * 103)
+      kc.nslow++;
+   if (now - kc.win_start >= KC_SECOND)
+      kc_eval(now);
+}
+
+void kiwami_clocks_flip(int64_t t_us)
+{
+   struct kc_event *e;
+   char b[32];
+   unsigned long v;
+   int64_t d;
+   int had;
+
+   if (!kc.on || kc.stopped)
+      return;
+   d            = t_us - kc.last_flip;
+   had          = kc.have_flip;
+   kc.last_flip = t_us;
+   kc.have_flip = 1;
+   if (!had || kc.held || kc.in_ff || !kc.have_last)
+      return;
+   if (d > KC_STALL_US)
+   {
+      kc_reset(kc.last_now);
+      return;
+   }
+   if (d <= kc.late_after_us)
+      return;
+   e         = kc_event(t_us, KC_LATE);
+   e->gap_us = (long)d;
+   e->pct    = kc_pct(kc.last_work);
+   e->cpu    = (unsigned)(kc.f[kc.cur] / 1000);
+   if (kc.gnf)
+   {
+      e->floor = (unsigned)(kc.g[kc.gcur] / 1000000);
+      if (kc_read(kc.gpu_dir, "cur_freq", b, sizeof(b)) && kc_num(b, &v))
+         e->gpu_at = (unsigned)(v / 1000000);
+   }
+   /* the frame's work on time: the GPU's pass was too slow */
+   if (kc.last_work * 5 >= kc.period_us * 4)
+   {
+      kc.n_late_cpu++;
+      kc_cpu_late(t_us, "late frame");
+   }
+   else
+      kc_late_short(t_us, "late flip", &kc.n_late_gpu);
+}
+
+static int kc_longest(const int64_t *t, int n)
+{
+   int i, best = -1;
+   for (i = 0; i < n; i++)
+      if (t[i] > 0 && (best < 0 || t[i] > t[best]))
+         best = i;
+   return best;
+}
+
+/* the CPU clock the game's memory keeps: the highest it was stepped up to
+ * at normal speed, which it needed; with none, the one it ended on, but not
+ * over the one it started a step above. -1: no time at normal speed */
+static int kc_cpu_memory(void)
+{
+   int i;
+
+   if (kc_longest(kc.time_at, kc.nf) < 0)
+      return -1;
+   if (kc.need >= 0)
+      return kc.need;
+   i = kc.in_ff ? kc.ff_from : kc.cur;
+   return kc.mem_cur >= 0 && kc.mem_cur < i ? kc.mem_cur : i;
+}
+
+static void kc_store(int ci, int gi)
+{
+   char tmp[1040];
+   FILE *fp;
+
+   if (!kc.store[0] || (ci < 0 && gi < 0))
+      return;
+   mkdir(kc.data_dir, 0755);
+   mkdir(kc.core_dir, 0755);
+   snprintf(tmp, sizeof(tmp), "%s.tmp", kc.store);
+   if (!(fp = fopen(tmp, "w")))
+      return;
+   if (ci >= 0)
+      fprintf(fp, "cpu %lu\n", kc.f[ci]);
+   if (gi >= 0)
+      fprintf(fp, "gpu %lu\n", kc.g[gi]);
+   if (fclose(fp) == 0)
+      rename(tmp, kc.store);
+   else
+      remove(tmp);
+}
+
+static void kc_log_end(int ci, int gi)
+{
+   FILE *fp;
+   long i;
+   int j, k, b;
+
+   if (!kc.log_path[0] || !(fp = fopen(kc.log_path, "a")))
+      return;
+   fprintf(fp, "kiwami-clocks: start: %s (%s), %.2f fps, %.2f Hz%s, "
+         "CPU %lu MHz (%s) of %lu-%lu",
+         kc.game, kc.core, kc.fps, kc.refresh_hz,
+         kc.synced ? " (the panel's rate)" : "",
+         kc.f[kc.start_cur] / 1000,
+         kc.mem_cpu ? "a step above this game's" : "the top",
+         kc.f[0] / 1000, kc.f[kc.nf - 1] / 1000);
+   if (kc.gnf)
+      fprintf(fp, ", GPU floor %lu MHz (%s) of %lu-%lu\n",
+            kc.g[kc.start_gcur] / 1000000,
+            kc.mem_gpu ? "this game's" : "the lowest",
+            kc.g[0] / 1000000, kc.g[kc.gnf - 1] / 1000000);
+   else
+      fprintf(fp, ", no GPU devfreq\n");
+   if (kc.nevents > KC_EVENTS)
+      fprintf(fp, "kiwami-clocks: %ld earlier lines not kept\n",
+            kc.nevents - KC_EVENTS);
+   for (i = kc.nevents > KC_EVENTS ? kc.nevents - KC_EVENTS : 0;
+         i < kc.nevents; i++)
+   {
+      const struct kc_event *e = &kc.ev[i % KC_EVENTS];
+      fprintf(fp, "kiwami-clocks: %.1f s: ", e->t_us / 1e6);
+      if (e->kind == KC_LATE)
+      {
+         fprintf(fp, "late flip %.1f ms, work %d%%, CPU %u MHz",
+               e->gap_us / 1e3, e->pct, e->cpu);
+         if (e->floor)
+            fprintf(fp, ", GPU floor %u MHz", e->floor);
+         if (e->gpu_at)
+            fprintf(fp, " at %u MHz", e->gpu_at);
+         fprintf(fp, "\n");
+         continue;
+      }
+      fprintf(fp, "%s %u -> %u MHz (%s", e->kind == KC_GPU ? "GPU floor"
+            : "CPU", e->from, e->to, e->why);
+      if (e->pct >= 0)
+         fprintf(fp, ", p99 %d%%", e->pct);
+      fprintf(fp, ")\n");
+   }
+   fprintf(fp, "kiwami-clocks: end after %.1f s, %ld steps\n",
+         kc.have_last ? (kc.last_now - kc.t0) / 1e6 : 0.0, kc.nsteps);
+   fprintf(fp, "kiwami-clocks: time at each CPU clock:");
+   for (j = 0; j < kc.nf; j++)
+      if (kc.time_at[j] > 0)
+         fprintf(fp, " %lu MHz %.1f s,", kc.f[j] / 1000,
+               kc.time_at[j] / 1e6);
+   fprintf(fp, " fast-forward %.1f s\n", kc.ff_us / 1e6);
+   if (kc.gnf)
+   {
+      fprintf(fp, "kiwami-clocks: time at each GPU floor:");
+      for (j = 0, k = 0; j < kc.gnf; j++)
+         if (kc.gtime_at[j] > 0)
+            fprintf(fp, "%s %lu MHz %.1f s", k++ ? "," : "",
+                  kc.g[j] / 1000000, kc.gtime_at[j] / 1e6);
+      fprintf(fp, "\n");
+   }
+   fprintf(fp, "kiwami-clocks: late frames: CPU %ld (late flip) %ld "
+         "(running slow), GPU %ld (late flip) %ld (running slow); "
+         "near the limit %ld, headroom %ld (%ld undone)\n",
+         kc.n_late_cpu, kc.n_slow_cpu, kc.n_late_gpu, kc.n_slow_gpu,
+         kc.n_near, kc.n_down, kc.n_undone);
+   for (j = kc.nf - 1; j >= 0; j--)
+   {
+      for (b = 0, k = 0; b <= 10; b++)
+         if (kc.p99_at[j][b])
+         {
+            if (!k++)
+               fprintf(fp, "kiwami-clocks: each second's slowest work at "
+                     "%lu MHz:", kc.f[j] / 1000);
+            fprintf(fp, "%s %d%% %ld s", k > 1 ? "," : "", b * 10,
+                  kc.p99_at[j][b]);
+         }
+      if (k)
+         fprintf(fp, "\n");
+   }
+   fprintf(fp, "kiwami-clocks: core frames per screen update: none %ld, "
+         "one %ld, two or more %ld\n", kc.n_upd[0], kc.n_upd[1], kc.n_upd[2]);
+   if (ci >= 0 || gi >= 0)
+   {
+      fprintf(fp, "kiwami-clocks: remembered in %s:", kc.store);
+      if (ci >= 0)
+         fprintf(fp, " cpu %lu", kc.f[ci]);
+      if (gi >= 0)
+         fprintf(fp, " gpu %lu", kc.g[gi]);
+      fprintf(fp, "\n");
+   }
+   fclose(fp);
+}
+
+void kiwami_clocks_stop(void)
+{
+   int ci, gi;
+
+   if (!kc.on || kc.stopped)
+      return;
+   kc.stopped = 1;
+   ci = kc_cpu_memory();
+   gi = kc.gnf ? kc_longest(kc.gtime_at, kc.gnf) : -1;
+   if (!kc.store[0])
+      ci = gi = -1;
+   kc_store(ci, gi);
+   kc_write(kc.cpu_dir, "scaling_governor", kc.old_gov);
+   kc_write_ul(kc.cpu_dir, "scaling_max_freq", kc.old_max);
+   kc_write_ul(kc.cpu_dir, "scaling_min_freq", kc.old_min);
+   if (kc.gnf)
+      kc_write_ul(kc.gpu_dir, "min_freq", kc.g[0]);
+   kc_log_end(ci, gi);
+}
+
+unsigned kiwami_clocks_mhz(void)
+{
+   return kc.on && !kc.stopped ? (unsigned)(kc.f[kc.cur] / 1000) : 0;
+}
