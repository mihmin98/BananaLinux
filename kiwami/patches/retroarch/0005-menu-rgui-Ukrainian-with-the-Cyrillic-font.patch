From: JorreFog <JorreFog@users.noreply.github.com>
Subject: [PATCH] menu/rgui: Ukrainian with the Cyrillic font

RGUI drew Russian and Belarusian with its 10x10 Cyrillic font (U+0400-045F)
but had no case for Ukrainian, which fell back to English ("language not
supported"). Ukrainian's letters are in that range too, except Ghe with
upturn (U+0490/0491), which is left out of the line as other missing glyphs.

Upstream-Status: Pending
---
--- a/menu/drivers/rgui.c
+++ b/menu/drivers/rgui.c
@@ -1871,6 +1871,7 @@ static bool rgui_fonts_init(rgui_t *rgui)
 
       case RETRO_LANGUAGE_RUSSIAN:
       case RETRO_LANGUAGE_BELARUSIAN:
+      case RETRO_LANGUAGE_UKRAINIAN:
       {
          rgui->fonts.eng_10x10    = bitmapfont_10x10_load(RETRO_LANGUAGE_ENGLISH);
          rgui->fonts.rus_10x10    = bitmapfont_10x10_load(RETRO_LANGUAGE_RUSSIAN);
@@ -5161,6 +5162,7 @@ static void rgui_set_blit_functions(
             break;
          case RETRO_LANGUAGE_RUSSIAN:
          case RETRO_LANGUAGE_BELARUSIAN:
+         case RETRO_LANGUAGE_UKRAINIAN:
             rgui_blit_line    = rgui_blit_line_rus_shadow;
             break;
          case RETRO_LANGUAGE_ESPERANTO:
@@ -5200,6 +5202,7 @@ static void rgui_set_blit_functions(
             break;
          case RETRO_LANGUAGE_RUSSIAN:
          case RETRO_LANGUAGE_BELARUSIAN:
+         case RETRO_LANGUAGE_UKRAINIAN:
             rgui_blit_line = rgui_blit_line_rus;
             break;
          case RETRO_LANGUAGE_ESPERANTO:
